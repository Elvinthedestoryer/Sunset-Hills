{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Room reservation record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "roomId": { "type": "string" },
        "checkIn": { "type": "string" },
        "checkOut": { "type": "string" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "hasPoolAddon": { "type": "boolean" }
      },
      "required": ["userId", "userEmail", "roomId", "checkIn", "checkOut", "totalPrice", "status", "createdAt"]
    },
    "GalleryImage": {
      "title": "Gallery Image",
      "description": "Image data for the resort gallery",
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "Base64 or URL of the image" },
        "caption": { "type": "string" },
        "category": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "order", "createdAt"]
    },
    "Room": {
      "title": "Room Listing",
      "description": "Details of a room available at the resort",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "amenities": { "type": "string", "description": "Comma separated amenities" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "image", "amenities", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Room booking documents"
    },
    "/gallery/{imageId}": {
      "schema": "GalleryImage",
      "description": "Gallery images"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Room listings"
    }
  }
}
