rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{uid} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'displayName']) &&
               data.keys().size() >= 3 && data.keys().size() <= 4 &&
               data.uid is string && data.uid.size() <= 128 &&
               data.email is string && data.email.size() <= 256 &&
               data.displayName is string && data.displayName.size() <= 128 &&
               (data.get('isAdmin', false) is boolean);
      }

      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && isValidUser(incoming()) && incoming().get('isAdmin', false) == false;
      allow update: if (isOwner(uid) || isAdmin()) && isValidUser(incoming()) && 
                    (isAdmin() || (incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])));
    }

    // --- Bookings Collection ---
    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return data.keys().hasAll(['userId', 'userEmail', 'roomId', 'checkIn', 'checkOut', 'totalPrice', 'status', 'createdAt']) &&
               data.keys().size() >= 8 && data.keys().size() <= 9 &&
               data.userId is string && data.userId.size() <= 128 &&
               data.userEmail is string && data.userEmail.size() <= 256 &&
               data.roomId in ['apex', 'horizon', 'serenity'] &&
               data.checkIn is string && data.checkIn.size() <= 10 &&
               data.checkOut is string && data.checkOut.size() <= 10 &&
               data.totalPrice is number && data.totalPrice > 0 &&
               data.status in ['pending', 'confirmed', 'cancelled'] &&
               data.createdAt is string && // or timestamp if we used serverValue but schema said string
               (data.get('hasPoolAddon', false) is boolean);
      }

      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidBooking(incoming()) && 
                    incoming().status == 'pending';
      allow update: if isSignedIn() && (isOwner(existing().userId) || isAdmin()) && isValidBooking(incoming()) &&
                    (
                      isAdmin() || 
                      (existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'cancelled')
                    );
      allow delete: if isAdmin();
    }
  }
}
